{
  "name": "partner-reference-application-mtx",
  "dependencies": {
    "@cap-js/sdm": "^1.8.2",
    "@cap-js/hana": "^2.6.0",
    "@sap/cds": "^9.7.1",
    "@sap/cds-mtxs": "^3.7.1",
    "@sap/xssec": "^4.12.2",
    "@sap/cds-oyster": "^0.2.1",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "features": {
      "assert_integrity": "db"
    },
    "profile": "mtx-sidecar",
    "requires": {
      "auth": "xsuaa",
      "destinations": true,
      "connectivity": true,
      "audit-log": true,
      "html5-host": {
        "vcap": {
          "label": "html5-apps-repo",
          "plan": "app-host"
        },
        "subscriptionDependency": {
          "uaa": "xsappname"
        }
      },
      "poetry-slams-print-service": {
        "vcap": {
          "label": "print"
        },
        "subscriptionDependency": {
          "uaa": "xsappname"
        }
      },
      "poetry-slams-jobscheduler": {
        "vcap": {
          "label": "jobscheduler"
        },
        "subscriptionDependency": {
          "uaa": "xsappname"
        }
      },
      "poetry-slams-sdm-integration": {
        "vcap": {
          "label": "sdm"
        },
        "subscriptionDependency": {
          "uaa": "xsappname"
        }
      },
      "cds.xt.ExtensibilityService": {
        "element-prefix": [
          "x_"
        ],
        "namespace-blocklist": [],
        "extension-allowlist": [
          {
            "for": [
              "*"
            ],
            "kind": "entity",
            "annotations": [
              "*"
            ],
            "code": [
              "CREATE",
              "READ",
              "UPDATE",
              "DELETE",
              "action",
              "function"
            ]
          },
          {
            "for": [
              "sap.samples.poetryslams.Visitors"
            ],
            "kind": "entity",
            "code": [
              "CREATE",
              "READ",
              "UPDATE",
              "DELETE",
              "action",
              "function"
            ]
          },
          {
            "for": [
              "PoetrySlamService"
            ],
            "kind": "service",
            "code": [
              "CREATE",
              "READ",
              "UPDATE",
              "DELETE",
              "action",
              "function"
            ]
          }
        ]
      }
    }
  }
}
